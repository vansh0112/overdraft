# Copy to .env (repo root) and fill in. Shared by gateway/ (TypeScript) and python/.
# Never commit .env. Use fresh TEST wallets only, never your main wallet.

# --- Hedera testnet (ECDSA keys, 0x-prefixed hex, from portal.hedera.com) ---
HEDERA_NETWORK=hedera:testnet
HEDERA_RPC_URL=https://testnet.hashio.io/api
# Optional, comma-separated backups used when the main relay is down
HEDERA_RPC_FALLBACK_URLS=https://296.rpc.thirdweb.com
# Pays for deployments and acts as the Overdraft admin; for test 1 it also receives the owner/pool/compute shares.
HEDERA_OPERATOR_ID=0.0.0000000
HEDERA_OPERATOR_KEY=0x
# A customer agent that pays the agent's x402 endpoint. Needs USDC (faucet.circle.com -> Hedera Testnet).
HEDERA_CUSTOMER_ID=0.0.0000000
HEDERA_CUSTOMER_KEY=0x
# The borrowing agent's Hedera account: it signs its own loan requests (npm run create-accounts -- AGENT)
HEDERA_AGENT_ID=0.0.0000000
HEDERA_AGENT_KEY=0x

# Optional payout overrides (default to the operator for test 1)
OWNER_ACCOUNT_ID=
POOL_ACCOUNT_ID=
COMPUTE_BUCKET_ACCOUNT_ID=

# --- x402 gateway (TypeScript) ---
FACILITATOR_URL=https://x402.org/facilitator
USDC_TOKEN_ID=0.0.429274
GATEWAY_PORT=4021
GATEWAY_URL=http://localhost:4021
# Price per translation in USDC smallest units (6 decimals): 20000 = $0.02
PRICE_ATOMIC=20000
# Optional: charge in HBAR instead of USDC (then PRICE_ATOMIC is tinybars, e.g. 100000 = 0.001 HBAR)
PAYMENT_ASSET=

# --- Python agent (internal; only the gateway calls it) ---
AGENT_INTERNAL_URL=http://localhost:5001
# Shared secret between the gateway and the agent (generate a long random value)
AGENT_INTERNAL_TOKEN=

# Filled in by `python -m overdraft.cli deploy-splitter` (saved to deployments/hedera-testnet.json)
SPLITTER_CONTRACT_ID=

# --- Arkiv (Rabdi testnet) ---
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
# Optional: raises rate limits (hub.arkiv.network/access-keys, network Rabdi)
ARKIV_ACCESS_KEY=
# The credit bureau wallet: owns every bureau entity. Fund it at hub.arkiv.network/faucet
ARKIV_BUREAU_KEY=0x

# --- 0G mainnet (chain 16661) ---
# placeholder: run the Hedera side with a local AI balance; 0g: real compute account and inference
COMPUTE_MODE=placeholder
ZG_RPC_URL=https://evmrpc.0g.ai
ZG_ROUTER_URL=https://router-api.0g.ai/v1
# The agent's 0G account (sign in at pc.0g.ai with this wallet; keep it settling in 0G, not USD)
ZG_AGENT_ADDRESS=
# The agent's API key (sk-...) from pc.0g.ai
ZG_AGENT_API_KEY=
# Optional read-only management key (mk-..., scope account:read) for exact balances
ZG_AGENT_MGMT_KEY=
# The lender wallet that funds deposits (holds 0G on mainnet). Test wallet only.
ZG_DEPOSITOR_KEY=
# 0G/USD price snapshot used to convert loans
ZG_PRICE_USD=0.157
# Safety caps for the relay
ZG_MAX_DEPOSIT_0G=1.0
ZG_DAILY_CAP_0G=5.0
# Models: normal and cheaper (used when the balance runs low)
ZG_MODEL=qwen3.5-flash
ZG_MODEL_CHEAP=qwen-flash
# Optional: prefer TEE-verified providers (standard | verified | private)
ZG_TRUST_MODE=
